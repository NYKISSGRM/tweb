<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS, только системные сертификаты. Без исключений для localhost/debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
