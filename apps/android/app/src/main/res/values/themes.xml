<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основная тема: тёмное окно, чтобы до первой отрисовки страницы не было белой вспышки. -->
    <style name="Theme.NykissGram" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/felt_black</item>
        <item name="android:colorBackground">@color/felt_black</item>
        <item name="android:statusBarColor">@color/felt_black</item>
        <item name="android:navigationBarColor">@color/felt_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Стартовая тема: сплэш (тёмный фон + золотая N), после старта переключается на Theme.NykissGram. -->
    <style name="Theme.NykissGram.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/felt_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NykissGram</item>
        <item name="android:statusBarColor">@color/felt_black</item>
        <item name="android:navigationBarColor">@color/felt_black</item>
    </style>

    <!-- Прозрачное окно точки входа: сразу уходит в Chrome, без белой вспышки. -->
    <style name="Theme.NykissGram.Launch" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
